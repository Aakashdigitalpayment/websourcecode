define(
    'COOP_VAPID_PRIVATE_PEM',
    "-----BEGIN EC PRIVATE KEY-----\n" .
    "REPLACE_WITH_YOUR_PRIVATE_KEY_LINES\n" .
    "-----END EC PRIVATE KEY-----"
);
define('COOP_VAPID_SUBJECT', 'mailto:admin@yourcoop.example');
