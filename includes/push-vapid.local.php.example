 * Per-site Web Push VAPID keys (copy → push-vapid.local.php on server).
 *
 *   cp includes/push-vapid.local.php.example includes/push-vapid.local.php
 *
 * push-vapid.local.php is gitignored (*.local.php). Generate a new pair on each
 * production install if you rotate keys; existing subscribers may need to re-enable push.
 */
